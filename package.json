{
  "name": "ali-turan-furniture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-images.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-images.mjs && vite build && node scripts/generate-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "render:assets": "node scripts/render-assets.mjs",
    "render:models": "node scripts/render-model-preview.mjs",
    "render:nass": "node scripts/render-nass-preview.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.180.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
